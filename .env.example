# .env.example — export values in your shell; the server does not auto-load .env.
API_HOST=127.0.0.1
API_PORT=8080
ONYX_CONFIG_PATH=./config/onyx-database.json
# Required explicitly for schema publishing and optional live tests.
ONYX_DATABASE_ID=
# Alternatively export ONYX_DATABASE_API_KEY and ONYX_DATABASE_API_SECRET.
